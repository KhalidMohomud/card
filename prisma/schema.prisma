generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SUPERVISOR
}

enum ReceiptStatus {
  COMPLETED
  CANCELLED
}

enum ExpenseType {
  GENERAL
  WORKER_COMMISSION
  SUPERVISOR_SALARY
}

enum FinancialStatus {
  UNPAID
  PAID
}

enum RecordStatus {
  ACTIVE
  CANCELLED
}

enum InventoryItemType {
  CONSUMABLE
  REUSABLE
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum InventoryIssueStatus {
  DRAFT
  ISSUED
  CLOSED
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE_IN
  CONSUMABLE_ISSUE_OUT
  CONSUMABLE_RETURN_IN
  DAMAGED_OUT
  LOST_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STOCKTAKE_IN
  STOCKTAKE_OUT
}

enum InventoryCondition {
  GOOD
  NEEDS_REPAIR
  DAMAGED
  LOST
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  fullName        String
  role            UserRole  @default(SUPERVISOR)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  accounts        Account[]

  receiptsCreated       Receipt[]           @relation("ReceiptCreator")
  receiptsCancelled     Receipt[]           @relation("ReceiptCanceller")
  receiptReprints       ReceiptReprint[]
  expensesForSupervisor Expense[]           @relation("ExpenseSupervisor")
  expensesCreated       Expense[]           @relation("ExpenseCreator")
  expensesCancelled     Expense[]           @relation("ExpenseCanceller")
  purchasesCreated      Purchase[]
  issuesReceived        InventoryIssue[]    @relation("IssueSupervisor")
  issuesCreated         InventoryIssue[]    @relation("IssueCreator")
  issuesClosed          InventoryIssue[]    @relation("IssueCloser")
  issuesCancelled       InventoryIssue[]    @relation("IssueCanceller")
  movementsCreated      InventoryMovement[]
  auditLogs             AuditLog[]

  @@index([role, isActive])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model LoginThrottle {
  key             String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  expiresAt       DateTime
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
}

model BusinessSetting {
  id            String   @id @default("singleton")
  businessName  String
  phone         String
  email         String
  address       String
  currencyCode  String   @default("USD")
  receiptFooter String   @default("Thank You")
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Service {
  id          String    @id @default(cuid())
  name        String    @unique
  price       Decimal   @db.Decimal(12, 2)
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  receipts    Receipt[]
}

model PaymentMethod {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  receipts  Receipt[]
  expenses  Expense[]
  purchases Purchase[]
}

model Receipt {
  id                   Int              @id @default(autoincrement())
  idempotencyKey       String           @unique
  serviceId            String
  service              Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  paymentMethodId      String
  paymentMethod        PaymentMethod    @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentReference     String?
  createdByUserId      String
  createdByUser        User             @relation("ReceiptCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  serviceNameSnapshot  String
  servicePriceSnapshot Decimal          @db.Decimal(12, 2)
  status               ReceiptStatus    @default(COMPLETED)
  issuedAt             DateTime         @default(now())
  cancelledAt          DateTime?
  cancelledByUserId    String?
  cancelledByUser      User?            @relation("ReceiptCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  cancellationReason   String?
  printCount           Int              @default(0)
  reprints             ReceiptReprint[]

  @@index([createdByUserId, issuedAt])
  @@index([serviceId, issuedAt])
  @@index([status, issuedAt])
  @@index([paymentMethodId, issuedAt])
  @@index([issuedAt])
}

model ReceiptReprint {
  id        String   @id @default(cuid())
  receiptId Int
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  printedAt DateTime @default(now())

  @@index([receiptId, printedAt])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id                       String           @id @default(cuid())
  type                     ExpenseType
  categoryId               String?
  category                 ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supervisorUserId         String?
  supervisor               User?            @relation("ExpenseSupervisor", fields: [supervisorUserId], references: [id], onDelete: Restrict)
  paymentMethodId          String?
  paymentMethod            PaymentMethod?   @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  title                    String
  expenseDate              DateTime
  periodStart              DateTime?
  periodEnd                DateTime?
  carCount                 Int?
  ratePerCar               Decimal?         @db.Decimal(12, 2)
  amount                   Decimal          @db.Decimal(12, 2)
  paymentStatus            FinancialStatus  @default(UNPAID)
  paymentReference         String?
  notes                    String?
  status                   RecordStatus     @default(ACTIVE)
  cancellationReason       String?
  cancelledAt              DateTime?
  cancelledByUserId        String?
  cancelledByUser          User?            @relation("ExpenseCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  commissionOverrideReason String?
  createdByUserId          String
  createdByUser            User             @relation("ExpenseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([type, expenseDate])
  @@index([supervisorUserId, expenseDate])
  @@index([status, expenseDate])
  @@index([expenseDate, createdAt])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String     @unique
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
}

model InventoryCategory {
  id        String          @id @default(cuid())
  name      String          @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  items     InventoryItem[]
}

model InventoryItem {
  id                String               @id @default(cuid())
  categoryId        String
  category          InventoryCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sku               String               @unique
  name              String               @unique
  type              InventoryItemType
  unit              String
  minimumStockLevel Decimal              @default(0) @db.Decimal(14, 3)
  description       String?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  purchaseItems     PurchaseItem[]
  issueItems        InventoryIssueItem[]
  movements         InventoryMovement[]

  @@index([categoryId, isActive])
}

model Purchase {
  id                    String          @id @default(cuid())
  supplierId            String
  supplier              Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  paymentMethodId       String?
  paymentMethod         PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  supplierInvoiceNumber String?
  purchaseDate          DateTime
  status                PurchaseStatus  @default(DRAFT)
  paymentStatus         FinancialStatus @default(UNPAID)
  notes                 String?
  createdByUserId       String
  createdByUser         User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  items                 PurchaseItem[]

  @@index([purchaseDate])
  @@index([supplierId, purchaseDate])
  @@index([status, purchaseDate])
}

model PurchaseItem {
  id              String              @id @default(cuid())
  purchaseId      String
  purchase        Purchase            @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  inventoryItemId String
  inventoryItem   InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Decimal             @db.Decimal(14, 3)
  unitCost        Decimal             @db.Decimal(12, 2)
  movements       InventoryMovement[]

  @@unique([purchaseId, inventoryItemId])
  @@index([inventoryItemId])
}

model InventoryIssue {
  id                 String               @id @default(cuid())
  supervisorUserId   String
  supervisor         User                 @relation("IssueSupervisor", fields: [supervisorUserId], references: [id], onDelete: Restrict)
  issuedByUserId     String
  issuedByUser       User                 @relation("IssueCreator", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  issueDate          DateTime
  status             InventoryIssueStatus @default(DRAFT)
  notes              String?
  createdAt          DateTime             @default(now())
  closedAt           DateTime?
  closedByUserId     String?
  closedByUser       User?                @relation("IssueCloser", fields: [closedByUserId], references: [id], onDelete: Restrict)
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledByUser    User?                @relation("IssueCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  cancellationReason String?
  items              InventoryIssueItem[]

  @@index([supervisorUserId, issueDate])
  @@index([status, issueDate])
  @@index([issueDate])
}

model InventoryIssueItem {
  id               String              @id @default(cuid())
  inventoryIssueId String
  inventoryIssue   InventoryIssue      @relation(fields: [inventoryIssueId], references: [id], onDelete: Restrict)
  inventoryItemId  String
  inventoryItem    InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantityIssued   Decimal             @db.Decimal(14, 3)
  quantityReturned Decimal             @default(0) @db.Decimal(14, 3)
  quantityDamaged  Decimal             @default(0) @db.Decimal(14, 3)
  quantityLost     Decimal             @default(0) @db.Decimal(14, 3)
  conditionOut     InventoryCondition  @default(GOOD)
  conditionIn      InventoryCondition?
  returnedAt       DateTime?
  notes            String?
  movements        InventoryMovement[]

  @@unique([inventoryIssueId, inventoryItemId])
  @@index([inventoryItemId])
}

model InventoryMovement {
  id                   String                @id @default(cuid())
  inventoryItemId      String
  inventoryItem        InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  movementType         InventoryMovementType
  quantity             Decimal               @db.Decimal(14, 3)
  purchaseItemId       String?
  purchaseItem         PurchaseItem?         @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  inventoryIssueItemId String?
  inventoryIssueItem   InventoryIssueItem?   @relation(fields: [inventoryIssueItemId], references: [id], onDelete: Restrict)
  notes                String?
  createdByUserId      String
  createdByUser        User                  @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt            DateTime              @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([inventoryIssueItemId, createdAt])
  @@index([movementType, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}
