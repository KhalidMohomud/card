DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional but recommended for migrations; Prisma CLI falls back to DATABASE_URL.
DIRECT_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

ADMIN_NAME="Administrator"
ADMIN_USERNAME="admin"
# Generate this value with: npm run auth:hash-password -- "YOUR_STRONG_PASSWORD"
ADMIN_PASSWORD_HASH="PASTE_GENERATED_SCRYPT_HASH_HERE"

# Vercel sets VERCEL=1 automatically. Enable this only behind a trusted reverse
# proxy that overwrites (rather than forwards user-supplied) X-Forwarded headers.
TRUST_PROXY_HEADERS="false"
